<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <title>AI Assistant · {{.Character}}</title>
    <style>
        body { background: #0f0f12; color: #e5e5e5; }
        .panel { background: #18181d; border: 1px solid #2a2a33; border-radius: 10px; }
        .q-unique { color: #bfa969; } .q-set { color: #10B981; } .q-rare { color: #FBBF24; }
        .q-magic { color: #60A5FA; } .q-crafted { color: #FFA500; } .q-low { color: #9CA3AF; }
        .msg-user { background: #23232b; }
        .msg-ai { background: #1d2333; border-left: 3px solid #6b7cff; }
        .card { background: #14181f; border: 1px solid #34405a; }
        button:disabled { opacity: .5; cursor: wait; }
    </style>
</head>
<body class="min-h-screen">
<div class="max-w-6xl mx-auto px-4 py-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <div>
            <a href="/" class="text-sm text-gray-400 hover:text-gray-200">&larr; Dashboard</a>
            <h1 class="text-2xl font-bold">AI Assistant · {{.Character}}</h1>
            <p class="text-sm text-gray-400">
                {{if .Memory.Enabled}}Claude brain online · {{.Memory.Games}} games remembered · this session ${{printf "%.2f" .Memory.SpentUSD}} ({{.Memory.Calls}} calls)
                {{else}}<span class="text-amber-400">Brain disabled — set <code>enabled: true</code> in config/brain.yaml and add an API key.</span>{{end}}
                {{if not .Running}} · <span class="text-amber-400">bot not running: start it to give the AI live gear and stash data</span>{{end}}
            </p>
        </div>
    </div>

    <div class="grid lg:grid-cols-5 gap-5">
        <!-- Chat -->
        <section class="panel p-4 lg:col-span-3 flex flex-col" style="min-height: 70vh">
            <div id="chat" class="flex-1 overflow-y-auto space-y-3 mb-3"></div>
            <div class="flex flex-wrap gap-2 mb-2" id="quick">
                <button class="text-xs px-2 py-1 rounded bg-gray-800 hover:bg-gray-700" data-q="Which runewords can I make right now from my stash, and which one should I make first?">Runeword planner</button>
                <button class="text-xs px-2 py-1 rounded bg-gray-800 hover:bg-gray-700" data-q="Look at my gear and build. Write pickit rules for the upgrades I should be picking up.">Pickit rules for my build</button>
                <button class="text-xs px-2 py-1 rounded bg-gray-800 hover:bg-gray-700" data-q="Why am I dying or chickening? Look at my run history, resistances and lessons, and suggest fixes.">Why do I die?</button>
                <button class="text-xs px-2 py-1 rounded bg-gray-800 hover:bg-gray-700" data-q="Suggest the best run list for my character right now.">Best runs for me</button>
                <button class="text-xs px-2 py-1 rounded bg-gray-800 hover:bg-gray-700" data-q="What is the single best upgrade I should hunt for next, and where does it drop?">Next upgrade</button>
            </div>
            <form id="ask" class="flex gap-2">
                <input id="msg" class="flex-1 rounded bg-gray-900 border border-gray-700 px-3 py-2" placeholder="Ask anything, e.g. pick up white 4-socket Broad Swords for Spirit" autocomplete="off">
                <button id="send" class="px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-500 font-semibold">Ask</button>
            </form>
            <p class="text-xs text-gray-500 mt-2">Nothing changes until you press Apply on a card. Each question costs a few cents (Opus).</p>
        </section>

        <!-- Memory + armory -->
        <aside class="lg:col-span-2 space-y-5">
            <section class="panel p-4">
                <h2 class="font-semibold mb-2">Goal</h2>
                <p class="text-sm">{{if .Memory.Goal}}{{.Memory.Goal}}{{else}}<span class="text-gray-500">No goal yet. The AI sets one before its first game.</span>{{end}}</p>
            </section>

            <section class="panel p-4">
                <h2 class="font-semibold mb-2">Run record</h2>
                {{if .Memory.Runs}}
                <table class="w-full text-sm">
                    <thead class="text-gray-400"><tr><th class="text-left">Run</th><th>Tries</th><th>OK</th><th>Deaths</th><th>Chickens</th><th>Items</th></tr></thead>
                    <tbody>
                    {{range .Memory.Runs}}
                    <tr class="border-t border-gray-800"><td>{{.Name}}</td><td class="text-center">{{.Attempts}}</td><td class="text-center">{{.SuccessPct}}%</td><td class="text-center text-red-400">{{.Deaths}}</td><td class="text-center text-amber-400">{{.Chickens}}</td><td class="text-center">{{.Items}}</td></tr>
                    {{end}}
                    </tbody>
                </table>
                {{else}}<p class="text-sm text-gray-500">No runs recorded yet.</p>{{end}}
            </section>

            <section class="panel p-4">
                <h2 class="font-semibold mb-2">Lessons learned</h2>
                {{if .Memory.Lessons}}
                <ul class="text-sm space-y-1 list-disc pl-5">{{range .Memory.Lessons}}<li><span class="text-gray-500">lvl {{.Level}}:</span> {{.Text}}</li>{{end}}</ul>
                {{else}}<p class="text-sm text-gray-500">None yet. The AI writes one after each death or chicken.</p>{{end}}
            </section>

            {{if .Memory.Thoughts}}
            <section class="panel p-4">
                <h2 class="font-semibold mb-2">Latest thoughts (overlay)</h2>
                <div class="text-sm space-y-1 text-gray-300">{{range .Memory.Thoughts}}<p>{{.}}</p>{{end}}</div>
            </section>
            {{end}}

            <section class="panel p-4">
                <h2 class="font-semibold mb-2">Armory</h2>
                {{if .Armory}}
                <div class="text-sm max-h-96 overflow-y-auto">
                    {{$loc := ""}}
                    {{range .Armory}}
                        {{if ne .Location $loc}}{{$loc = .Location}}<h3 class="mt-3 mb-1 text-xs uppercase tracking-wide text-gray-400">{{.Location}}</h3>{{end}}
                        <div class="{{if eq .Quality "Unique"}}q-unique{{else if eq .Quality "Set"}}q-set{{else if eq .Quality "Rare"}}q-rare{{else if eq .Quality "Magic"}}q-magic{{else if eq .Quality "Crafted"}}q-crafted{{else}}q-low{{end}}">
                            {{.Name}}{{if .Ethereal}} <span class="text-gray-500">(eth)</span>{{end}}{{if .Sockets}} <span class="text-gray-500">· {{.Sockets}}</span>{{end}}
                        </div>
                    {{end}}
                </div>
                {{else}}<p class="text-sm text-gray-500">Start the bot to see gear, inventory and stash.</p>{{end}}
            </section>
        </aside>
    </div>
</div>

<script>
const SUP = {{.Supervisor}};
const chat = document.getElementById('chat');
const form = document.getElementById('ask');
const input = document.getElementById('msg');
const sendBtn = document.getElementById('send');
const history = [];

function el(tag, cls, text) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
}

function addMessage(role, text) {
    const box = el('div', 'rounded p-3 whitespace-pre-wrap text-sm ' + (role === 'user' ? 'msg-user' : 'msg-ai'));
    box.appendChild(el('div', 'text-xs text-gray-400 mb-1', role === 'user' ? 'You' : 'Claude'));
    box.appendChild(el('div', '', text));
    chat.appendChild(box);
    chat.scrollTop = chat.scrollHeight;
    return box;
}

function describe(p) {
    switch (p.kind) {
        case 'pickit_rule': return p.pickitRule;
        case 'runs': return (p.runs || []).join(' → ');
        case 'chicken_on_curses': return (p.curses || []).length ? p.curses.join(', ') : '(none)';
        case 'goal': return p.goal;
    }
    return '';
}

const kindLabel = {pickit_rule: 'Pickit rule', runs: 'Run list', chicken_on_curses: 'Chicken on curses', goal: 'AI goal'};

function addCard(parent, p) {
    const card = el('div', 'card rounded p-3 mt-2');
    card.appendChild(el('div', 'text-xs text-indigo-300', kindLabel[p.kind] || p.kind));
    card.appendChild(el('div', 'font-semibold', p.title));
    if (p.why) card.appendChild(el('div', 'text-gray-400 text-xs mb-1', p.why));
    card.appendChild(el('code', 'block text-xs bg-black/40 rounded p-2 my-2 break-all', describe(p)));
    const btn = el('button', 'px-3 py-1 rounded bg-emerald-600 hover:bg-emerald-500 text-sm font-semibold', 'Apply');
    const status = el('span', 'ml-2 text-xs');
    btn.onclick = async () => {
        btn.disabled = true;
        try {
            const r = await fetch('/api/assistant/apply', {
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({supervisor: SUP, proposal: p})
            });
            const t = await r.text();
            if (!r.ok) throw new Error(t);
            status.textContent = '✓ ' + JSON.parse(t).result;
            status.className = 'ml-2 text-xs text-emerald-400';
            btn.textContent = 'Applied';
        } catch (e) {
            status.textContent = '✗ ' + e.message;
            status.className = 'ml-2 text-xs text-red-400';
            btn.disabled = false;
        }
    };
    const row = el('div'); row.appendChild(btn); row.appendChild(status);
    card.appendChild(row);
    parent.appendChild(card);
}

async function ask(text) {
    text = text.trim();
    if (!text) return;
    addMessage('user', text);
    input.value = '';
    sendBtn.disabled = true;
    const pending = addMessage('ai', 'Thinking…');
    try {
        const r = await fetch('/api/assistant', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({supervisor: SUP, message: text, history: history})
        });
        const t = await r.text();
        if (!r.ok) throw new Error(t);
        const reply = JSON.parse(t);
        pending.lastChild.textContent = reply.reply;
        (reply.proposals || []).forEach(p => addCard(pending, p));
        if (reply.questionId) {
            waitForDesktop(reply.questionId, pending, text);
        } else {
            history.push({role: 'user', text: text}, {role: 'assistant', text: reply.reply});
        }
    } catch (e) {
        pending.lastChild.textContent = 'Error: ' + e.message;
    } finally {
        sendBtn.disabled = false;
        input.focus();
    }
}

// Desktop mode: Claude Desktop answers when you ask it to; check every 3 s for up to 30 minutes.
async function waitForDesktop(id, bubble, question) {
    for (let i = 0; i < 600; i++) {
        await new Promise(res => setTimeout(res, 3000));
        try {
            const r = await fetch('/api/assistant/answer?id=' + id);
            if (!r.ok) continue;
            const q = await r.json();
            if (q.answered) {
                bubble.lastChild.textContent = q.answer;
                (q.proposals || []).forEach(p => addCard(bubble, p));
                history.push({role: 'user', text: question}, {role: 'assistant', text: q.answer});
                return;
            }
        } catch (e) { /* Koolo restarting: keep waiting */ }
    }
    bubble.lastChild.textContent += ' (no answer after 30 minutes; ask again when Claude Desktop is open)';
}

form.addEventListener('submit', e => { e.preventDefault(); ask(input.value); });
document.querySelectorAll('#quick button').forEach(b => b.addEventListener('click', () => ask(b.dataset.q)));
</script>
</body>
</html>
